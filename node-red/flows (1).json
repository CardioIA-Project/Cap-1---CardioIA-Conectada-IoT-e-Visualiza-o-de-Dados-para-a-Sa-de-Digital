    {
        "id": "function_cardioia",
        "type": "function",
        "z": "686e1eaa86af3df6",
        "name": "Separar dados CardioIA",
        "func": "let dados = msg.payload;\n\nlet bpm = {\n    payload: dados.bpm,\n    topic: \"BPM\"\n};\n\nlet temperatura = {\n    payload: dados.temperatura,\n    topic: \"Temperatura\"\n};\n\nlet movimento = {\n    payload: dados.movimento,\n    topic: \"Movimento\"\n};\n\nlet timestamp = {\n    payload: dados.timestamp,\n    topic: \"Timestamp\"\n};\n\nlet http = {\n    payload: {\n        bpm: dados.bpm,\n        temperatura: dados.temperatura,\n        movimento: dados.movimento,\n        timestamp: dados.timestamp\n    }\n};\n\nreturn [bpm, temperatura, movimento, timestamp, http];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
